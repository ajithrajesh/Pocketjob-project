# ==============================================================
# PocketJob Backend Environment Variables Template
# Copy these values into your Render Dashboard -> Environment tab
# ==============================================================

# Server Port (Render sets this automatically, default is 10000 on Render)
PORT=5000

# Node Environment ('production' for Render, 'development' for local)
NODE_ENV=production

# Frontend Client URL (e.g., your Vercel or Netlify frontend URL)
# Used for CORS and password reset email links. Multiple URLs can be comma-separated.
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas)
# NOTE: Ensure Atlas Network Access allows 0.0.0.0/0 (all IPs)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Secret Key for token signing and verification
JWT_SECRET=replace_with_a_secure_random_string

# Cloudinary Credentials (for image/document uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer with Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_character_app_password

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
